<UserControl x:Class="PlateArchive.Wpf.Views.SelettoreArticoloGestionaleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    Selettore "Codice articolo gestionale" (TASK-19) — riusato dai tre form piastra
    (PiastreView, NuovaPiastraDialog, ImportaDisegnoWindow) per le piastre Speciale Cliente.
    DataContext: SelettoreArticoloGestionaleViewModel (proprietà SelettoreArticolo dell'host).
    Pattern chip + suggerimenti come il selettore cliente esclusivo; se il gestionale non è
    raggiungibile degrada a TextBox libero (CodiceLibero).
    -->
    <StackPanel>

        <!-- Articolo selezionato (chip con X) -->
        <Border Visibility="{Binding IsArticoloSelezionatoVisible, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource Brush.PrimarySubtle}"
                BorderBrush="{DynamicResource Brush.Primary}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.S}"
                Padding="10,6"
                Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding RimuoviArticoloCommand}"
                        ToolTip="Rimuovi"
                        Margin="8,0,0,0">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="{StaticResource FontWeight.SemiBold}"
                               Text="{Binding ArticoloSelezionato.Codice}"/>
                    <TextBlock Text="{Binding ArticoloSelezionato.Descrizione, TargetNullValue=''}"
                               FontSize="{StaticResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Ricerca articolo (solo con gestionale disponibile) -->
        <Grid Margin="0,0,0,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRicercaVisible}" Value="True"/>
                                <Condition Binding="{Binding IsSelettoreAttivo}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding RicaricaCommand}"
                        ToolTip="Ricarica articoli dal gestionale"
                        Margin="6,0,0,0">
                    <!-- &#xE72C; = Refresh -->
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal"/>
                </Button>
                <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Cerca l'articolo per codice o descrizione"
                         Style="{StaticResource FieldBox}"
                         Margin="0"/>
            </DockPanel>

            <Border Grid.Row="1"
                    Visibility="{Binding IsSuggerimentiVisible, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.S}"
                    Margin="0,2,0,0">
                <ItemsControl ItemsSource="{Binding Suggerimenti}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Ghost}"
                                    HorizontalContentAlignment="Left"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.SelezionaArticoloCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Codice}"
                                               FontWeight="{StaticResource FontWeight.SemiBold}"/>
                                    <TextBlock Text="{Binding Descrizione}"
                                               FontSize="{StaticResource FontSize.Caption}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- Fallback: gestionale non raggiungibile → codice a testo libero -->
        <TextBox Text="{Binding CodiceLibero, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldBox}"
                 Visibility="{Binding IsFallbackLibero, Converter={StaticResource BoolToVis}}"/>

        <!-- Errore lettura gestionale -->
        <TextBlock Text="{Binding Errore}"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSize.Caption}"
                   Foreground="{DynamicResource Brush.Warning}"
                   Margin="0,-4,0,8"
                   Visibility="{Binding IsErroreVisible, Converter={StaticResource BoolToVis}}"/>

        <!-- Avviso non bloccante dall'host (es. formato non censito) -->
        <TextBlock Text="{Binding Avviso}"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSize.Caption}"
                   Foreground="{DynamicResource Brush.Warning}"
                   Margin="0,-4,0,8"
                   Visibility="{Binding IsAvvisoVisible, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
